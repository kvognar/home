#home
  .header
    = image_tag 'laurel_and_kevin_crop.jpg', class: 'profile-image', title: "Illustration by Kay O'Neill"
    h1 Kevin Vognar
    h4 Developer, writer, thought-collector
  .previews-container
    .project-preview
      a href=days_url
        h3 A photo a day
        - if @day.photo_of_the_day.present?
          = image_tag @day.photo.url(:medium), class: 'day-photo'
    .project-preview
      a href=code_games_url
        h3 Games
        = image_tag 'fall_from_grace.gif'
    .project-preview
      a href=media_works_url
        h3 Medialog
        - if @media_work.media_image.present?
          = image_tag(@media_work.media_image.image.url(:medium))
        - else
          .medium= svg("icons/#{@media_work.medium}")

= render partial: 'links/gmtk_webring'
